@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<h1>Не удалось выполнить запрос</h1>
<p>Попробуйте ещё раз или вернитесь к списку заказов.</p>

@if (Model.ShowRequestId)
{
    <p>
        Номер запроса <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Orders" asp-action="Index">К списку заказов</a>
