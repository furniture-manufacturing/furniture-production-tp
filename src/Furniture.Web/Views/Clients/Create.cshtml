@model ClientForm
@{ ViewData["Title"] = "Новый клиент"; var forOrder = ViewBag.ForOrder is true; }
<div class="content">
    @if (forOrder) { <a class="back-link text-link" asp-controller="Orders" asp-action="Create">К оформлению заказа</a> }
    else { <a class="back-link text-link" asp-action="Index">Все клиенты</a> }
    <div class="page-heading"><h1>Новый клиент</h1></div>
    <form class="editor-form order-form" asp-action="Create" method="post">
        <input type="hidden" name="forOrder" value="@forOrder.ToString().ToLowerInvariant()">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <partial name="_Fields" model="Model" />
        <div class="form-actions"><button class="button button-primary">Сохранить клиента</button></div>
    </form>
</div>
