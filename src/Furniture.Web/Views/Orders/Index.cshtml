@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Заказы";
}

<div class="page-heading">
    <h1>Заказы</h1>
    <a class="btn btn-primary" asp-action="Create">Создать заказ</a>
</div>

@if (Model.Count == 0)
{
    <div class="surface empty-state">
        <p>Заказов пока нет.</p>
    </div>
}
else
{
    <div class="surface table-responsive">
        <table class="table align-middle order-table">
            <thead>
                <tr>
                    <th scope="col">Номер</th>
                    <th scope="col">Клиент</th>
                    <th scope="col">Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><a class="order-number" asp-action="Details" asp-route-id="@order.Id">@order.Number</a></td>
                        <td>@order.Client.FullName</td>
                        <td><span class="status-badge @(order.Status == OrderStatus.New ? "status-waiting" : "")">@order.Status.Ru()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
