@model IReadOnlyList<Order>
@{
    ViewData["Title"] = "Заказы";
    var query = Context.Request.Query;
    var clients = (IReadOnlyList<Client>)ViewBag.Clients;
    var employees = (IReadOnlyList<Employee>)ViewBag.Employees;
}
<div class="page-heading">
    <h1>Заказы</h1>
    <a class="button button-primary" asp-action="Create">Создать заказ</a>
</div>
<form class="filters" method="get">
    <label>Номер, клиент или телефон <input name="q" type="search" value="@query["q"]"></label>
    <label>Статус
        <select name="status">
            <option value="">Все статусы</option>
            @foreach (var status in Enum.GetValues<OrderStatus>())
            {
                <option value="@status" selected="@(query["status"] == status.ToString())">@status.Ru()</option>
            }
        </select>
    </label>
    <label>Клиент
        <select name="clientId">
            <option value="">Все клиенты</option>
            @foreach (var client in clients)
            {
                <option value="@client.Id" selected="@(query["clientId"] == client.Id.ToString())">@client.FullName</option>
            }
        </select>
    </label>
    <label>Исполнитель
        <select name="employeeId">
            <option value="">Все исполнители</option>
            @foreach (var employee in employees)
            {
                <option value="@employee.Id" selected="@(query["employeeId"] == employee.Id.ToString())">@employee.FullName</option>
            }
        </select>
    </label>
    <label>Создан с <input name="from" type="date" value="@query["from"]"></label>
    <label>По <input name="to" type="date" value="@query["to"]"></label>
    @if (query["waiting"] == "true")
    {
        <input type="hidden" name="waiting" value="true">
        <span>Ждут исполнителя</span>
    }
    <button class="button button-secondary">Найти</button>
    @if (query.Count > 0) { <a class="text-link" asp-action="Index">Сбросить</a> }
</form>
<div class="table-scroll" role="region" tabindex="0" aria-label="Список заказов">
    <table class="order-table">
        <thead><tr><th scope="col">Заказ</th><th scope="col">Клиент</th><th scope="col">Создан</th><th scope="col">Плановый срок</th><th scope="col">Статус</th></tr></thead>
        <tbody>
        @if (Model.Count == 0) { <tr><td class="empty" colspan="5">Заказы не найдены.</td></tr> }
        @foreach (var order in Model)
        {
            <tr>
                <th scope="row">
                    <a class="text-link" asp-action="Details" asp-route-id="@order.Id">@order.Number</a>
                    @if (order.ParentOrderId.HasValue) { <span class="optional">Подзаказ</span> }
                </th>
                <td>@order.Client.FullName</td>
                <td class="phone">@WorkshopDates.Local(order.CreatedAt).ToString("dd.MM.yyyy")</td>
                <td class="phone">@order.PlannedCompletionDate.ToString("dd.MM.yyyy")</td>
                <td><span class="order-status @(order.Status == OrderStatus.New ? "status-queued" : "status-assigned")">@order.Status.Ru()</span></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<p class="totals">Всего <strong>@Model.Count</strong></p>
