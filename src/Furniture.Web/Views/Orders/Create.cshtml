@model OrderForm
@{ ViewData["Title"] = Model.ParentOrderId.HasValue ? "Новый подзаказ" : "Новый заказ"; }
<div class="content">
    @if (Model.ParentOrderId.HasValue)
    {
        <a class="back-link text-link" asp-action="Details" asp-route-id="@Model.ParentOrderId">К заказу @Model.ParentNumber</a>
    }
    else
    {
        <a class="back-link text-link" asp-action="Index">К списку заказов</a>
    }
    <div class="page-heading"><h1>@ViewData["Title"]</h1></div>
    <form class="editor-form order-form" asp-action="Create" method="post">
        <div asp-validation-summary="All" role="alert"></div>
        @if (Model.ParentOrderId.HasValue)
        {
            <input asp-for="ParentOrderId" type="hidden">
            <input asp-for="ClientId" type="hidden">
            <label>Причина подзаказа
                <select asp-for="SubOrderReason" required>
                    <option value="">Выберите причину</option>
                    @foreach (var reason in Enum.GetValues<SubOrderReason>())
                    {
                        <option value="@reason">@reason.Ru()</option>
                    }
                </select>
            </label>
        }
        else
        {
            <label>Клиент
                <select asp-for="ClientId" required>
                    <option value="">Выберите клиента</option>
                    @foreach (var client in Model.Clients)
                    {
                        <option value="@client.Id" data-address="@client.DefaultAddress">@client.FullName · @client.Phone</option>
                    }
                </select>
            </label>
            <a class="text-link" asp-controller="Clients" asp-action="Create">Добавить клиента</a>
        }
        <label>Адрес выполнения <input asp-for="ExecutionAddress" maxlength="500" required></label>
        <label>Плановый срок <input asp-for="PlannedCompletionDate" type="date" asp-format="{0:yyyy-MM-dd}" required></label>
        <label>Пожелания клиента <textarea asp-for="CustomerWishes" rows="4"></textarea></label>
        <div class="form-actions"><button class="button button-primary">@ViewData["Title"]</button></div>
    </form>
</div>
